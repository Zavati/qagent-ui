{
  "name": "qagent-ui",
  "version": "0.1.3",
  "description": "QAgent UI domain: immutable replay bundle assembly and qualification",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cf-types": "wrangler types",
    "typecheck": "npm run cf-types && tsc --noEmit",
    "test": "node tools/test-bundles.mjs",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test",
    "deploy": "npm run check && node tools/configure.mjs --check && wrangler deploy",
    "ops": "node tools/ui-ops.mjs",
    "test:integration": "node tools/test-integration.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@types/node": "24.10.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.121.0"
  },
  "private": true
}

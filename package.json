{
  "name": "qagent-ui",
  "version": "0.3.0",
  "description": "QAgent UI: immutable observed evidence and deterministic paired Test Design compilation",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cf-types": "wrangler types",
    "typecheck": "npm run cf-types && tsc --noEmit",
    "test": "node tools/test-bundles.mjs",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm run test:pc2 && npm run test:pc3 && npm run test:source-diagnostics && npm run test:td1",
    "deploy": "npm run check && node tools/configure.mjs --check && wrangler deploy",
    "ops": "node tools/ui-ops.mjs",
    "test:integration": "node tools/test-integration.mjs",
    "test:pc2": "node tools/test-page-copy.mjs",
    "test:pc3": "node tools/test-page-copy-observed.mjs",
    "test:source-diagnostics": "node tools/test-page-source-diagnostics.mjs",
    "test:root-recovery": "node tools/test-page-root-recovery.mjs",
    "test:td1": "node tools/test-ui-test-design.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@types/node": "24.10.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.121.0"
  },
  "private": true
}
